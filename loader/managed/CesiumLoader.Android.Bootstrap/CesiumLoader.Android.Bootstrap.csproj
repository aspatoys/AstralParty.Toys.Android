<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CesiumLoader.Android.Bootstrap</AssemblyName>
    <RootNamespace>CesiumLoader.Android.Bootstrap</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 刻意不引用 SDK 与游戏程序集：本程序集在 HybridCLR 里运行，
       所有外部依赖都在运行时从 /sdcard/CesiumLoader 用 Assembly.Load 加载。 -->

</Project>
