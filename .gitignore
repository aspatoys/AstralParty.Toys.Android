/loader/**/bin/
/loader/**/obj/
/loader/**/__pycache__/
/loader/build/

# 打包产物
*.apk
*.aab
*.ap_

# 内置悬浮窗的托管构建产物。
/mods/**/bin/
/mods/**/obj/
