<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <CesiumSdkDll Condition="'$(CesiumSdkDll)' == ''">$(MSBuildThisFileDirectory)../app/src/main/assets/cesium/sdk/CesiumLoader.SDK.dll</CesiumSdkDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameRefs)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
